config DMC_RUN_SMBUS_TESTS
	bool "SMBUS test shell command"
	help
	  Add the "smc smbus_test" shell command, which runs DMC<->SMC SMBus
	  tests on demand. This can be used to verify functionality of the
	  SMBUS interface.

source "Kconfig.zephyr"
